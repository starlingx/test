{
  // Release data for the application platform-upgrade compatibility tests.
  //
  // Data only. The test cases hold the steps and the assertions; nothing here decides what a test
  // does, which probe it runs, or which phases it exercises. A test reads the release it is
  // upgrading to, and the name and namespace of the application to act on, and nothing else.
  //
  // The release a test starts from is not configured here; it is read from the platform at
  // runtime. The release a test upgrades to is "to_version" below, which does have to be updated
  // when the target release changes.
  "to_version": "26.10",
  "applications": {
    "cert-manager": {
      "app_name": "cert-manager",
      "namespace": "cert-manager",
    },
    "oran-o2": {
      "app_name": "oran-o2",
      "namespace": "oran-o2",
    },
  },
}
