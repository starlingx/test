{
  // Release data for the application platform-upgrade compatibility tests.
  //
  // Data only. The test cases hold the steps and the assertions; nothing here decides what a test
  // does, which probe it runs, or which phases it exercises. A test reads the release it is
  // upgrading to, and the application version to expect on a given release, and nothing else.
  //
  // Versions are matched by containment, so keep them at the release prefix. Pinning a build
  // suffix such as "26.03-90" fails a baseline check whenever a lab is reinstalled from a newer
  // respin, before any upgrade work has started.
  "to_version": "26.10",
  "applications": {
    "cert-manager": {
      "app_name": "cert-manager",
      "namespace": "cert-manager",
      "versions": { "25.09": "25.09-", "26.03": "26.03-", "26.10": "26.10-" },
    },
    "portieris": {
      "app_name": "portieris",
      "namespace": "portieris",
      "versions": { "25.09": "25.09-", "26.03": "26.03-", "26.10": "26.10-" },
    },
    "oran-o2": {
      "app_name": "oran-o2",
      "namespace": "oran-o2",
      "versions": { "25.09": "25.09-", "26.03": "26.03-", "26.10": "26.10-" },
    },
    // No "versions" map here on purpose: get_app_version() has no caller, so an istio entry would
    // only add release literals nothing reads.
    "istio": {
      "app_name": "istio",
      "namespace": "istio-system",
    },
    // oidc-auth-apps installs into kube-system, which it shares with the control plane, so its
    // test narrows pod reads by label rather than relying on the namespace alone.
    //
    // No "versions" map: get_app_version() on this config object has no caller anywhere in the
    // tree, and a separate change tracks removing the maps the other entries still carry. This
    // entry is deliberately the shape the others will have once that merges.
    "oidc-auth-apps": {
      "app_name": "oidc-auth-apps",
      "namespace": "kube-system",
    },
    // No "versions" map here either, for the same reason as istio. The dell-storage test asserts
    // the release prefix against the release the platform reports, so no per-release lookup is
    // ever performed.
    "app-dell-storage": {
      "app_name": "dell-storage",
      "namespace": "dell-storage",
    },
    // No "versions" map here either, for the same reason as istio: get_app_version() has no
    // caller. The metrics-server test matches the release prefix against the release the
    // platform reports, so no per-release lookup is performed.
    "metrics-server": {
      "app_name": "metrics-server",
      "namespace": "metrics-server",
    },
  },
}
