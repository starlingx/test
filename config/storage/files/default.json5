{
  "credentials": {
    "user_name": "admin",
    "password": ""
  },
  "storage_network": {
    // Default storage-network address and interface. Used for single-node (simplex)
    // labs, and as the fallback for any node not listed under "nodes" below.
    "ip_address": "",
    "interface_name": "",
    // Per-node storage-network setup, required by the STD dell-storage tests.
    // An STD lab has to bring the storage network up on every node, because the
    // csi-powerstore pods and the test pods can be scheduled anywhere. Controllers
    // and computes usually cable the storage network on different NICs, and each
    // node needs its OWN address on that subnet, so both values are per node here.
    // Anything left empty falls back to "ip_address"/"interface_name" above.
    "nodes": {
      "controller-0": { "ip_address": "", "interface_name": "" },
      "controller-1": { "ip_address": "", "interface_name": "" },
      "compute-0": { "ip_address": "", "interface_name": "" },
      "compute-1": { "ip_address": "", "interface_name": "" }
    }
  },
  // Lab specific storage array values. Populate these in a local override
  // config file, do not commit real values to this repository.
  "storage_array": {
    "array_id": "",
    "endpoint": "",
    "nas_name": ""
  }
}
